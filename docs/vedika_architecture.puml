@startuml vedika_architecture
!pragma layout smetana
allowmixing
skinparam linetype polyline
skinparam packageTitleAlignment center
skinparam ArrowMessageAlignment center
skinparam ArrowFontName Arial

' ==============================================================================
' GLOBAL LAYOUT & SPACING
' ==============================================================================
skinparam nodesep 20
skinparam ranksep 20

<style>
package {
    Padding 8
}
class {
    Padding 8
}
interface {
    Padding 8
}
package<<System>> {
    LineStyle 2
    LineColor #000
    BackgroundColor transparent
    Margin 20
}
package {
    Padding 8
    LineColor #000
}
arrow {
    LineThickness 2
    LineColor #000
    FontColor #000
    FontSize 12
}
</style>

' ==============================================================================
' ICON MACROS
' ==============================================================================
!$ICON_CONFIG = "<&cog> "
!$ICON_ORCH   = "<&layers> "
!$ICON_APP    = "<color:red><&bug></color> "
!$ICON_DOMAIN = "<color:green><&star></color> "
!$ICON_INFRA  = "<&box> "

' ==============================================================================
' ARROW MACROS (BOLD & STYLED)
' ==============================================================================
!$USE = ".[#red,thickness=2].>"
!$FLOW = "-[thickness=2]->"
!$EXTENDS = "-[bold]-|>"
!$HEAVY_FLOW = "-[thickness=3]->"
!$IMPLEMENTS = ".[bold].|>"
!$COMPOSES = "*-[bold]->"
!$AGGREGATES_RED = "o-[#red,bold]->"
!$IMPLEMENTS_RED = ".[#red,bold].|>"
!$EXTENDS_BLUE_AGG = "o-[#blue,bold]-|>"
!$EXTENDS_RED_COMP = "*-[#red,bold]-|>"

' ==============================================================================
' SYSTEM BOUNDARY
' ==============================================================================
package "ETL Data Pipeline System" #line:Red;line.bold;back:White {

    ' ==============================================================================
    ' CONFIGURATION & ENTRY LAYER
    ' ==============================================================================
    package "$ICON_CONFIG Configuration & Entry Layer" #line:DarkGreen;line.bold;back:LightGreen {
        class "run_etl.py / Justfile" as Entrypoint <<Orchestrator>> {
            Triggers execution environment
        }

        class Settings <<pydantic.BaseModel>> {
            + database_type: Literal['mongo', 'postgres']
            + connections: dict
            + storage_routes: dict
        }
    }

    ' ==============================================================================
    ' ORCHESTRATION LAYER (ZENML)
    ' ==============================================================================
    package "$ICON_ORCH Orchestration Layer (ZenML)" #line:Gray;line.bold {
        class "Pipeline: digital_data_etl" as Pipeline <<@pipeline>> #line:blue;line.bold;back:LightYellow {
            + user_full_name: str
            + links: list[str]
        }

        class "Step: get_or_create_user" as Step1 <<@step>> {
            + get_or_create_user(user_full_name: str)
        }

        class "Step: crawl_links" as Step2 <<@step>> {
            + crawl_links(user, urls, force_recrawl)
        }

        class "Step: clean_documents" as Step3 <<@step>> {
            + clean_documents(category, force_reclean)
        }

        class CrawlMetadataTracker {
            + record(url: str, status: CrawlStatus)
            + full_metadata: dict
        }
    }

    ' ==============================================================================
    ' APPLICATION LAYER (USE CASES, SERVICES, PORT INTERFACES)
    ' ==============================================================================
    package "$ICON_APP Application Layer" {

        package "Services (Use Cases)" {
            class CrawlerService {
                + crawl_and_save(url, user_id, force_recrawl): CrawlStatus
            }
            class CleaningService {
                + clean(data: BaseRawDomain): BaseCleanedDomain
                + clean_and_save_category(category, force_reclean): dict
            }
        }

        package "Preprocessing" {
            class CleaningHandlerFactory {
                + create_handler(category): BaseCleaningHandler
            }
            class CodebaseCleaningHandler {
                + clean(data: CodebaseRawDomain): CodebaseCleanedDomain
            }
        }

        package "Interfaces (Ports)" {
            interface BaseCrawler {
                + category: DataCategory
                + extract(url, user_id): BaseRawDomain
            }
            interface BaseCleaningHandler<<Generic[RawT, CleanT]>> {
                + clean(data: RawT): CleanT
            }
            interface BaseUserRepository {
                + get_or_create_user(first_name, last_name)
            }
            interface BaseRawRepository<<Generic[RawT]>> {
                + exists_by_url(url: str): bool
                + save(document: RawT): None
                + get_all(): Iterator[RawT]
            }
            interface BaseCleanedRepository<<Generic[CleanT]>> {
                + exists_by_id(id: UUID): bool
                + save(document: CleanT): None
            }
        }
    }

    ' ==============================================================================
    ' DOMAIN LAYER (CORE BUSINESS LOGIC)
    ' ==============================================================================
    package "$ICON_DOMAIN Domain Layer (Pure Python)" #line:Blue;line.bold;back:LightCyan {
        enum DataCategory <<StrEnum>> {
            USERS
            CODEBASES
            ARTICLES
        }

        enum DataState <<StrEnum>> {
            RAW
            CLEANED
            CHUNKED
        }

        class UserDomain <<BaseModel>> {
            + id: UUID = Field(default_factory=uuid4)
            + first_name: str
            + last_name: str
            + full_name(): str <<property>>
        }

        abstract class BaseRawDomain <<BaseModel>> {
            + id: UUID
            + content: str
            + category: DataCategory
            + state: DataState = RAW
        }

        abstract class BaseCleanedDomain <<BaseModel>> {
            + id: UUID
            + content: str
            + category: DataCategory
            + state: DataState = CLEANED
        }

        class CodebaseRawDomain <<BaseRawDomain>> {
            + category = CODEBASES
        }

        class CodebaseCleanedDomain <<BaseCleanedDomain>> {
            + category = CODEBASES
        }
    }

    ' ==============================================================================
    ' INFRASTRUCTURE LAYER (ADAPTERS & DB)
    ' ==============================================================================
    package "$ICON_INFRA Infrastructure Layer" {

        package "Crawlers Adapter" {
            class CrawlerRegistry {
                + get_crawler(url: str): BaseCrawler
            }
            class GithubCrawler {
                + category = CODEBASES
                + extract(url, user_id): CodebaseRawDomain
            }
        }

        package "Database Adapters" {
            class DBFactory <<Singleton>> {
                + get_user_repository(): BaseUserRepository
                + get_raw_repository(category): BaseRawRepository
                + get_cleaned_repository(category): BaseCleanedRepository
            }

            class UserMongoRepository {
                + get_or_create_user(...)
            }

            class CodebaseRawMongoRepository {
                + save(document: CodebaseRawDomain)
                + get_all(): Iterator[CodebaseRawDomain]
            }

            class CodebaseCleanedMongoRepository {
                + save(document: CodebaseCleanedDomain)
            }
        }

        database "MongoDB\n(Raw & Cleaned Collections)" as Database
    }
}

' ==============================================================================
' RELATIONSHIPS & DATA FLOW
' ==============================================================================

' Execution Flow
Entrypoint $FLOW Pipeline : "Triggers"
Pipeline $COMPOSES Step1
Pipeline $COMPOSES Step2
Pipeline $COMPOSES Step3

' Step 1 (User Flow)
Step1 $FLOW DBFactory : "1. get_user_repository()"
Step1 $FLOW BaseUserRepository : "2. get_or_create_user()"

' Step 2 (Crawler Orchestration)
Step2 $FLOW CrawlerService : "3. crawl_and_save()"
Step2 $USE CrawlMetadataTracker : "Tracks metrics"
CrawlerService $FLOW CrawlerRegistry : "Resolves Crawler"
CrawlerRegistry $FLOW GithubCrawler : "Returns Instance"
GithubCrawler $USE CodebaseRawDomain : "Extracts Raw Entity"
CrawlerService $FLOW DBFactory : "Gets RawRepo"
CrawlerService $FLOW BaseRawRepository : "4. save(raw_domain)"

' Step 3 (Cleaning Orchestration)
Step3 $FLOW CleaningService : "5. clean_and_save_category()"
CleaningService $FLOW BaseRawRepository : "Reads Iterator"
CleaningService $FLOW CleaningHandlerFactory : "Gets Handler"
CleaningHandlerFactory $FLOW CodebaseCleaningHandler : "Returns Instance"
CodebaseCleaningHandler $USE CodebaseCleanedDomain : "6. Transforms to Cleaned Entity"
CleaningService $FLOW DBFactory : "Gets CleanedRepo"
CleaningService $FLOW BaseCleanedRepository : "7. save(cleaned_domain)"

' Infrastructure Implementations (Interface Fulfillment)
UserMongoRepository $IMPLEMENTS_RED BaseUserRepository
CodebaseRawMongoRepository $IMPLEMENTS_RED BaseRawRepository
CodebaseCleanedMongoRepository $IMPLEMENTS_RED BaseCleanedRepository
GithubCrawler $IMPLEMENTS_RED BaseCrawler
CodebaseCleaningHandler $IMPLEMENTS_RED BaseCleaningHandler

' Domain Inheritance
CodebaseRawDomain $EXTENDS_BLUE_AGG BaseRawDomain
CodebaseCleanedDomain $EXTENDS_BLUE_AGG BaseCleanedDomain

' DB Operations
UserMongoRepository $AGGREGATES_RED Database
CodebaseRawMongoRepository $AGGREGATES_RED Database
CodebaseCleanedMongoRepository $AGGREGATES_RED Database

' ==============================================================================
' DIAGRAM LEGEND
' ==============================================================================
legend bottom right
    | = Icon / Line Type | = Meaning & System Usage |
    | 🟢 **C** (Green Circle) | **Concrete Class:** Can be instantiated. |
    | 🔵 **A** (Blue Circle) | **Abstract Class:** Base class for inheritance. |
    | 🟣 **I** (Purple Circle) | **Interface:** A structural contract (e.g., BaseRepositories). |
    | ◁-- (Solid Triangle) | **Inherits:** Shows child inheriting from parent. |
    | ◁.. (Dashed Triangle)| **Implements:** Shows concrete adapter fulfilling Interface. |
    | --> (Solid Arrow) | **Execution Flow:** Chronological action or direct trigger. |
    | ..> (Dashed Arrow) | **Dependency:** Data mapping or instantiation without strict coupling. |
endlegend

@enduml
